			"text": " while (exit == 0)\n    {\n        if(turno % 2 == 0)\n        {\n            print_board(boardG1M)\n            print_board(boardG1S);\n            input(1);\n            turno++;\n        }\n        else{\n            print_board(boardG2M);\n            print_board(boardG2S);\n            input(2);\n            turno++;\n        }\n        \n    }",
			"rawText": " while (exit == 0)\n    {\n        if(turno % 2 == 0)\n        {\n            print_board(boardG1M)\n            print_board(boardG1S);\n            input(1);\n            turno++;\n        }\n        else{\n            print_board(boardG2M);\n            print_board(boardG2S);\n            input(2);\n            turno++;\n        }\n        \n    }",
